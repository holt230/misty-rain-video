# Docker 镜像名称与版本
IMAGE_NAME=registry.example.com/your-namespace/misty-rain-video
IMAGE_TAG=latest

# 容器对外端口由 docker-compose.yml 固定为 5200
TZ=Asia/Shanghai
APP_PUBLIC_URL=https://example.com/misty-rain/

# 可选：仅建议在首次认证前设置。已有 data/.quark_key 时保持为空。
QUARK_CONFIG_SECRET=

# 视频仅直连，需要 TV 播放认证；不提供服务器视频中转模式。
# TV 认证服务会接收授权码及刷新令牌；可替换为兼容的 HTTPS 服务。
TV_TOKEN_EXCHANGE_URL=https://api.extscreen.com/quarkdrive/token

# 自动补集与失效来源恢复。多副本时只能在一个实例启用。
LIBRARY_AUTO_MAINTENANCE=true
LIBRARY_MAINTENANCE_MINUTES=30

# 首批检索等待上限默认 8 秒，后台检索最多持续 30 秒并自动补齐候选。
RESOURCE_SEARCH_TIMEOUT_MS=8000
